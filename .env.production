# PUBLIC build-time values for production builds (`npm run deploy:cloudflare`).
# Next inlines NEXT_PUBLIC_* into the browser bundle at BUILD time, so a build
# from a machine without .env.local used to ship without them (Turnstile widget
# missing -> every form rejected). Only public, browser-safe values belong here;
# secrets stay in `wrangler secret put`. .env.local still overrides these.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADhCa-ZxFoFE8kIe
# Cloudflare Web Analytics (site txquince.com). The beacon token is public: it
# ships in every page's HTML. Read by src/components/WebAnalytics.tsx.
NEXT_PUBLIC_CF_BEACON_TOKEN=89374711f47b4a4195bc5c30f32e7822
# Clerk: TX Quince's own app (production instance on txquince.com). Public
# values only; CLERK_SECRET_KEY is a Worker secret (`npx wrangler secret put CLERK_SECRET_KEY`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudHhxdWluY2UuY29tJA
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
