# ============================================================================
# TX Quince — environment variables
# Copy to .env.local for development. Set the same keys in Vercel for prod.
# NEVER commit real secrets. The service-role key is SERVER-ONLY.
# ============================================================================

# ---- Media (Cloudflare R2, operator-owned) --------------------------------
# Public base URL of your R2 bucket (custom domain recommended).
# e.g. https://media.txquince.com  OR  https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_BASE_URL=

# ---- Supabase (inquiry storage) -------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# SERVICE ROLE / secret key — SERVER ONLY. Bypasses RLS. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public values (safe in browser) — used ONLY for admin login/session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed into /admin (image + video uploads).
ADMIN_EMAILS=you@example.com

# ---- Resend (transactional email) -----------------------------------------
RESEND_API_KEY=
# Where operator inquiry notifications are sent.
OPERATOR_NOTIFY_EMAIL=you@example.com
# From address. Requires a VERIFIED sending domain (SPF/DKIM) in Resend.
# For LOCAL TESTING ONLY you may use: "TX Quince <onboarding@resend.dev>"
RESEND_FROM="TX Quince <hello@txquince.com>"

# ---- Cloudflare Turnstile (anti-abuse, primary gate) ----------------------
# Public site key (safe to expose) + secret key (server only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Stripe (self-serve date reservation deposit) -------------------------
# Until both are set, /reserve shows a friendly "deposits aren't live yet" note
# and steers families to the inquiry form — nothing breaks.
#
# SETUP:
#   1. Create a Stripe account (or reuse one). Copy the SECRET key (sk_live_… /
#      sk_test_…) — SERVER ONLY, never expose to the browser.
#   2. Add a webhook endpoint in the Stripe Dashboard:
#        URL:    https://txquince.com/api/stripe/webhook
#        Event:  checkout.session.completed
#      Copy its signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET.
#   3. Enable payment methods in Dashboard → Settings → Payment methods:
#      Card + Affirm/Klarna/Afterpay → families can pay the $500 deposit now OR
#      in interest-free installments. Checkout shows them automatically.
#   4. Local webhook testing:
#        stripe listen --forward-to localhost:3210/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Absolute origin for Stripe redirect URLs. Optional — falls back to Vercel's
# deployment URL, then to the production domain in src/content/site.ts.
NEXT_PUBLIC_SITE_URL=

# ---- AI alt text (optional) -----------------------------------------------
# Powers the "AI" / "Write blank alt text" buttons in /admin/portfolio, which
# draft accessibility + SEO alt text for photos with a vision model. Without
# this key those buttons return a friendly "not configured" message; everything
# else works. Get a key at https://vercel.com/ai-gateway (works on any host).
AI_GATEWAY_API_KEY=
# Optional override. Default: anthropic/claude-haiku-4-5 (cheap + fast vision).
ALT_TEXT_MODEL=
