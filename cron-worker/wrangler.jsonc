{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "txquince-followups-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // Daily at 16:00 UTC (~10–11am Central). Adjust as desired.
  "triggers": { "crons": ["0 16 * * *"] },
  "vars": { "TARGET_URL": "https://txquince.com" },
  "observability": { "enabled": true }
  // CRON_SECRET is set as a secret, not committed:
  //   npx wrangler secret put CRON_SECRET
}
