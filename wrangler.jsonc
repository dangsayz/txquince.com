{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "txquince",
  // Custom entry: re-exports OpenNext's fetch handler and adds `scheduled`
  // for the Cron Trigger below (client journey daily run, /api/cron/daily).
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference enables OpenNext's ISR/queue revalidation on Workers.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "txquince"
    }
  ],
  // Cloudflare Images binding powers next/image optimization on Workers.
  "images": {
    "binding": "IMAGES"
  },
  // Portfolio photos (moved off Supabase Storage). PRIVATE — /api/img is the
  // only public reader, /api/admin/upload the only writer.
  "r2_buckets": [
    {
      "binding": "PORTFOLIO",
      "bucket_name": "txquince-portfolio"
    },
    // Signed contract PDFs (contracts/<bookingId>/<sha256>.pdf). PRIVATE —
    // served only by the family's private link or to the admin. The bucket
    // must be created by the owner before deploy: wrangler r2 bucket create txquince-contracts
    {
      "binding": "CONTRACTS",
      "bucket_name": "txquince-contracts"
    }
  ],
  // Durable per-IP rate limits (src/lib/rate-limit.ts). Counters live in
  // Cloudflare, per location, and survive isolate recycling. namespace_id is
  // any integer unique in the Cloudflare account; nothing to create in the
  // dashboard. Keep limit/period equal to RATE_LIMITS (a test checks it).
  "ratelimits": [
    {
      // /api/commission and /api/inquiry: 5 per minute per IP (separate keys).
      "name": "RATE_LIMIT_FORMS",
      "namespace_id": "47101",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // /api/track and /api/csp-report: 60 per minute per IP.
      "name": "RATE_LIMIT_TRACK",
      "namespace_id": "47102",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Daily client-journey run: expire lapsed holds (+ their Stripe sessions),
  // balance reminders, owner/family nudges. 13:05 UTC ≈ 8:05 AM in Dallas
  // (CDT) / 7:05 AM (CST). Idempotent — safe if Cloudflare fires it twice.
  // Needs the CRON_SECRET secret (wrangler secret put CRON_SECRET — owner only).
  "triggers": {
    "crons": ["5 13 * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://txquince.com"
  },
  "routes": [
    { "pattern": "txquince.com", "custom_domain": true },
    { "pattern": "www.txquince.com", "custom_domain": true }
  ]
}
